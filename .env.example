APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_KEY=


DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=app
DB_USERNAME=app
DB_PASSWORD=app


QUEUE_CONNECTION=redis
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS=<your-email>
MAIL_FROM_NAME="App"

SESSION_DRIVER=cookie
SESSION_DOMAIN=localhost
SANCTUM_STATEFUL_DOMAINS=localhost:8080,localhost:5173

CACHE_DRIVER=array
SESSION_DRIVER=cookie


AI_PROVIDER=<your-provider>
AI_MODEL=<your-model>
AI_MODEL_THINKING=<your-model>
GPT5_API_KEY=<your-key>
GPT5_BASE_URL=<your-base-url>
AI_REQUEST_TIMEOUT=60
AI_JSON_STRICT=1

# Async and parallel processing
AI_ASYNC_ENABLED=false
AI_PARALLEL_MAX=5

# Rate limiting (prevent API throttling)
AI_RATE_LIMIT_ENABLED=true
AI_RATE_LIMIT_RPM=60
AI_RATE_LIMIT_RETRIES=3
AI_RATE_LIMIT_RETRY_DELAY_MS=1000

# File Attachments (OpenAI Files API - alternative to text extraction)
AI_FILE_ATTACHMENTS_ENABLED=false
AI_FILE_ATTACHMENTS_AUTO_UPLOAD=true
AI_FILE_ATTACHMENTS_CLEANUP=true

# Text-to-Speech (OpenAI TTS)
AI_TTS_ENABLED=false
AI_TTS_API_KEY=  # If empty, uses AI_API_KEY
AI_TTS_BASE_URL=https://api.openai.com/v1
AI_TTS_MODEL=tts-1  # tts-1 (standard) or tts-1-hd (high quality)
AI_TTS_VOICE=alloy  # alloy, echo, fable, onyx, nova, shimmer
AI_TTS_SPEED=1.0  # 0.25 to 4.0
AI_TTS_TIMEOUT=60

DOC_MAX_MB=20
DOC_EXTRACTOR_FAKE=false
PDFTOTEXT_BIN=/usr/bin/pdftotext
DOC_OCR_ENABLED=false
TESSERACT_BIN=/usr/bin/tesseract
DOC_OCR_LANGS=eng
INTERNAL_API_BASE=http://nginx

# Server Monitoring & Alerting
MONITORING_ENABLED=true
TELEGRAM_NOTIFICATIONS_ENABLED=false
TELEGRAM_BOT_TOKEN=  # Get from @BotFather on Telegram
TELEGRAM_CHAT_ID=  # Your Telegram user ID or chat ID
MONITORING_ALERT_SERVER_ERRORS=true
MONITORING_ALERT_RATE_LIMIT=5  # Minutes between same error alerts


