{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:examhelp:golden-fixtures:phase-a:v1",
  "title": "Golden Fixture - Phase A (Skeleton)",
  "description": "Schema for exam skeleton without assembly plans",
  "type": "object",
  "required": ["version", "stage", "exam_id", "structure_v2"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string", "const": "1.0" },
    "stage": { "type": "string", "const": "phase_a" },
    "exam_id": { "type": "string" },

    "structure_v2": {
      "type": "object",
      "required": ["meta", "pass_policy", "sections"],
      "properties": {
        "id": { "type": "string" },
        "version": { "type": "string" },

        "meta": {
          "type": "object",
          "required": ["name", "language", "level"],
          "properties": {
            "name": { "type": "string" },
            "language": { "type": "string", "pattern": "^[a-z]{2}$" },
            "level": { "type": "string", "enum": ["A1", "A2", "B1", "B2", "C1", "C2"] },
            "provider": { "type": "string" },
            "tags": { "type": "array", "items": { "type": "string" } }
          }
        },

        "pass_policy": {
          "type": "object",
          "required": ["mode"],
          "properties": {
            "mode": { "type": "string", "enum": ["overall_only", "per_section_only", "mixed"] },
            "overall_threshold_percent": { "type": "number" },
            "per_section_threshold_percent": { "type": "number" }
          }
        },

        "policies": {
          "type": "object",
          "properties": {
            "navigation": { "type": "object" },
            "answer_transfer_window_sec": { "type": "integer" }
          }
        },

        "sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "skill", "duration_min", "max_score"],
            "properties": {
              "id": { "type": "string" },
              "skill": { "type": "string", "enum": ["listening", "reading", "writing", "speaking", "grammar", "vocabulary", "use_of_english"] },
              "name": { "type": "string" },
              "duration_min": { "type": "integer", "minimum": 1 },
              "max_score": { "type": "number", "minimum": 1 },
              "min_pass_percent": { "type": "number", "minimum": 0, "maximum": 100 },
              "description": { "type": "string" },
              "expected_task_count": {
                "type": "object",
                "properties": {
                  "target": { "type": "integer" },
                  "min": { "type": "integer" },
                  "max": { "type": "integer" }
                }
              }
            },
            "not": {
              "required": ["assembly"]
            }
          }
        }
      }
    },

    "_comparison_hints": { "$ref": "#/$defs/comparison_hints" },
    "_notes": { "type": "string" }
  },

  "$defs": {
    "comparison_hints": {
      "type": "object",
      "properties": {
        "critical_fields": { "type": "array", "items": { "type": "string" } },
        "flexible_fields": { "type": "array", "items": { "type": "string" } },
        "ignore_fields": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
