{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:examhelp:golden-fixtures:synthesis:v1",
  "title": "Golden Fixture - Synthesis (Final)",
  "description": "Schema for final synthesized exam with questions",
  "type": "object",
  "required": ["version", "stage", "exam_id", "sections"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string", "const": "1.0" },
    "stage": { "type": "string", "const": "synthesis" },
    "exam_id": { "type": "string" },

    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["key", "skill", "name"],
        "properties": {
          "key": { "type": "string" },
          "skill": { "type": "string", "enum": ["listening", "reading", "writing", "speaking", "grammar", "vocabulary", "use_of_english"] },
          "name": { "type": "string" },

          "question_groups": {
            "type": "array",
            "items": { "$ref": "#/$defs/question_group_full" }
          },

          "ungrouped_questions": {
            "type": "array",
            "items": { "$ref": "#/$defs/question_full" }
          }
        }
      }
    },

    "_comparison_hints": { "$ref": "#/$defs/comparison_hints" },
    "_notes": { "type": "string" }
  },

  "$defs": {
    "question_group_full": {
      "type": "object",
      "required": ["group_id", "title", "questions"],
      "properties": {
        "group_id": { "type": "string" },
        "title": { "type": "string" },
        "order": { "type": "integer" },
        "instructions": { "type": "object" },
        "stimulus": { "type": "object" },
        "playback_settings": { "type": "object" },
        "metadata": { "type": "object" },

        "questions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/question_full" }
        }
      }
    },

    "question_full": {
      "type": "object",
      "required": ["question_id", "type"],
      "properties": {
        "id": { "type": ["integer", "string"] },
        "question_id": { "type": "string" },
        "type": { "type": "string" },
        "order": { "type": "integer" },

        "interaction": {
          "type": "object",
          "properties": {
            "response_type": { "type": "string" },
            "input_type": { "type": "string" },
            "stem": { "type": "string" },
            "options": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": { "type": "string" },
                  "text": { "type": "string" },
                  "value": { "type": ["string", "number", "boolean"] }
                }
              }
            }
          }
        },

        "instructions": { "type": "object" },
        "stimulus": { "type": "object" },
        "scoring": { "type": "object" },
        "metadata": { "type": "object" },
        "response": { "type": "object" },

        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      }
    },

    "comparison_hints": {
      "type": "object",
      "properties": {
        "critical_fields": { "type": "array", "items": { "type": "string" } },
        "flexible_fields": { "type": "array", "items": { "type": "string" } },
        "ignore_fields": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
