includes:
  - vendor/nunomaduro/larastan/extension.neon

parameters:
  level: 6
  paths:
    - app
    - app/Domain
    - app/Services
    - app/Nova
    - database/seeders
  excludePaths:
    - database/migrations/*
    - storage/*
    - bootstrap/cache/*
    - vendor/*
  tmpDir: storage/framework/cache/phpstan
  
  checkModelProperties: true
  reportUnmatchedIgnoredErrors: true
  inferPrivatePropertyTypeFromConstructor: true

  ignoreErrors:
    - '#Call to an undefined static method Laravel\\Nova\\Nova::.*#'
    - '#Unsafe usage of new static\(\)#'
    - '#Call to an undefined static method Illuminate\\Support\\Facades\\(.*)::fake#'
    - '#Property .* does not accept null#'
    - '#Offset .* does not exist on array#'
    - identifier: missingType.iterableValue

  bootstrapFiles:
    - vendor/autoload.php
    - bootstrap/app.php
