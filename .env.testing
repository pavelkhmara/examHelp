APP_ENV=testing
APP_DEBUG=true
APP_URL=http://localhost
APP_KEY=base64:testing-key-change-me-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa==

# Изоляция от dev
CACHE_DRIVER=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array
BROADCAST_DRIVER=log
LOG_CHANNEL=stack
FILESYSTEM_DISK=local

# SQLite: изолированная БД для тестов
DB_CONNECTION=sqlite
DB_DATABASE=/var/www/html/database/testing.sqlite
DB_FOREIGN_KEYS=true

# Redis можно не поднимать для тестов
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379

# Доп. флаги, чтобы не стартовали тяжёлые вещи
TELESCOPE_ENABLED=false
CACHE_STORE=array
INTERNAL_API_BASE=http://nginx

