<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!-- окружение тестов -->
        <server name="APP_ENV" value="testing"/>

        <!-- отдельные кеш-файлы только для тестов -->
        <server name="APP_CONFIG_CACHE"   value="bootstrap/cache/config.testing.php"/>
        <server name="APP_EVENTS_CACHE"   value="bootstrap/cache/events.testing.php"/>
        <server name="APP_PACKAGES_CACHE" value="bootstrap/cache/packages.testing.php"/>
        <server name="APP_ROUTES_CACHE"   value="bootstrap/cache/routes.testing.php"/>
        <server name="APP_SERVICES_CACHE" value="bootstrap/cache/services.testing.php"/>

        <server name="QUEUE_CONNECTION" value="sync"/>
        <server name="AI_PROVIDER" value="mock"/>

        <!-- лёгкие драйверы в тестах -->
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>

        <!-- изолированная БД тестов (in-memory sqlite) -->
        <server name="DB_CONNECTION" value="sqlite"/>
        <server name="DB_DATABASE" value=":memory:"/>
    </php>


</phpunit>
